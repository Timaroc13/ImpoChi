# Copy to .env and fill in. Every value is public (shipped to the browser).
SITE_URL=https://dosdeltas.com

# WhatsApp Business number, digits only with country code (prefer +54). Leave empty to hide WhatsApp UI.
PUBLIC_WHATSAPP_NUMBER=
# Contact email shown on the site
PUBLIC_CONTACT_EMAIL=hola@dosdeltas.com
# Cal.com event slug, e.g. octa/llamada-20-min. Empty = no booking widget.
PUBLIC_CAL_LINK=
# LinkedIn profile URL of the founder
PUBLIC_LINKEDIN_URL=
# Founder photo (path under /public or absolute URL) and intro video (YouTube embed URL or MP4 path). Empty = hidden.
PUBLIC_FOUNDER_PHOTO=
PUBLIC_FOUNDER_VIDEO=

# Hong Kong entity. Leave empty until incorporated; the site never prints a placeholder number.
PUBLIC_HK_COMPANY_NAME=
PUBLIC_HK_COMPANY_NUMBER=
PUBLIC_HK_ADDRESS=

# Lead form: n8n / Zapier / Formspree endpoint that accepts multipart/form-data POST.
PUBLIC_FORM_ENDPOINT=

# Analytics (all optional; nothing loads until the visitor accepts cookies, except Consent Mode defaults)
PUBLIC_GA4_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_LEAD_LABEL=
PUBLIC_CLARITY_ID=
