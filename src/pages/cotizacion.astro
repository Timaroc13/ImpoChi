---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import WaLink from '../components/WaLink.astro';
import { TERMS } from '../config';
import { fmtUSD } from '../lib/format.js';
---
<Base
  title="Pedí tu cotización | Dos Deltas"
  description="Contame qué necesitás comprar en el sur de China. En 24 h hábiles te digo si puedo ayudarte. Sin comisiones de fábrica. Pedido mínimo USD 10.000."
  og="cotizacion"
  crumbs={[{ name: 'Pedí tu cotización', href: '/cotizacion' }]}
>
  <section class="pt-10">
    <div class="wrap max-w-[760px]">
      <p class="eyebrow">Cotización</p>
      <h1 class="mt-4 text-h1-m md:text-h1">Contame qué necesitás</h1>
      <p class="mt-4 text-ink">Con esto preparo la llamada de 20 minutos. Si avanzamos, la búsqueda cuesta <span class="fig">{fmtUSD(TERMS.searchFee)}</span> (<span class="fig">{fmtUSD(TERMS.searchFeeMachinery)}</span> en maquinaria). Pedido mínimo <span class="fig">{fmtUSD(TERMS.minOrder)}</span>.</p>
      <p class="mt-2 text-small text-ink-muted">¿Preferís escribir? <WaLink location="cotizacion-intro" class="font-semibold" label="Mandame un WhatsApp" />{' '}o un email.</p>
    </div>
  </section>
  <QuoteForm heading="Formulario" id="cotizar" />
</Base>
