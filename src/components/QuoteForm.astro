---
// Short RFQ form. Posts multipart/form-data to /api/lead (functions/api/lead.ts).
// Required: rubro, valor_pedido, producto, nombre, consentimiento, and WhatsApp OR email.
// Sends cookieless funnel events to /api/funnel (src/lib/funnel.js).
import { RUBROS } from '../data/verticals';
import { ORDER_VALUES } from '../lib/lead.js';
import { SITE, hasWhatsApp } from '../config';
import { waLink } from '../lib/lead.js';

interface Props { rubro?: string; heading?: string; id?: string }
const { rubro = '', heading = 'Pedí tu cotización', id = 'cotizar' } = Astro.props;

const fallbackWa = hasWhatsApp ? waLink(SITE.whatsapp, 'Hola Octa, intenté mandar el formulario y no funcionó. Te cuento mi pedido: ') : '';
const field = 'mt-2 block w-full rounded-sm border border-line bg-paper-raised px-4 py-3 text-body text-ink placeholder:text-ink-muted/80 aria-[invalid=true]:border-signal';
const labelCls = 'block font-semibold';
const opt = '<span class="text-ink-muted font-normal"> (opcional)</span>';
---
<section id={id} class="section scroll-mt-4 pb-24 md:pb-20" aria-labelledby={`${id}-title`}>
  <div class="wrap max-w-[760px]">
    <h2 id={`${id}-title`} class="text-h1-m md:text-h1">{heading}</h2>
    {SITE.preview && <p class="mt-4 rounded-sm bg-river-soft p-4 text-small text-ink">Vista previa: este formulario no envía datos. Al terminar te lleva a la página de confirmación.</p>}
    <p class="mt-2 text-ink-muted">Un minuto. Te respondo en 24 h hábiles, hora de Buenos Aires.</p>

    <form
      class="card mt-6 space-y-6 md:p-10"
      data-quote-form
      data-endpoint={SITE.formEndpoint}
      data-preview={SITE.preview ? '1' : undefined}
      novalidate
      enctype="multipart/form-data"
    >
      <!-- honeypot -->
      <div class="hidden" aria-hidden="true"><label>No completar <input type="text" name="empresa_web" tabindex="-1" autocomplete="off" /></label></div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label class={labelCls} for={`${id}-rubro`}>Rubro</label>
          <select id={`${id}-rubro`} name="rubro" required class={field} data-rubro-select>
            <option value="" disabled selected={!rubro}>Elegí una opción</option>
            {RUBROS.map((r) => <option value={r.value} selected={r.value === rubro} data-placeholder={r.placeholder}>{r.label}</option>)}
          </select>
        </div>
        <div>
          <label class={labelCls} for={`${id}-valor`}>Valor estimado del pedido</label>
          <select id={`${id}-valor`} name="valor_pedido" required class={field}>
            <option value="" disabled selected>Elegí una opción</option>
            {ORDER_VALUES.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
      </div>

      <div>
        <label class={labelCls} for={`${id}-producto`}>¿Qué necesitás?</label>
        <textarea id={`${id}-producto`} name="producto" rows="3" required minlength="10" maxlength="2000" class={field} data-specs placeholder={RUBROS.find((r) => r.value === rubro)?.placeholder ?? 'Producto, cantidad y lo que sepas de las especificaciones.'}></textarea>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label class={labelCls} for={`${id}-nombre`}>Nombre</label>
          <input id={`${id}-nombre`} name="nombre" type="text" required autocomplete="name" maxlength="120" class={field} />
        </div>
        <div>
          <label class={labelCls} for={`${id}-empresa`}>Empresa<Fragment set:html={opt} /></label>
          <input id={`${id}-empresa`} name="empresa" type="text" autocomplete="organization" maxlength="120" class={field} />
        </div>
      </div>

      <fieldset data-contact>
        <legend class="font-semibold">¿Cómo te contacto?</legend>
        <p class="mt-1 text-small text-ink-muted" id={`${id}-contact-hint`}>WhatsApp o email: con uno alcanza.</p>
        <div class="mt-2 grid gap-6 md:grid-cols-2">
          <div>
            <label class={labelCls} for={`${id}-wa`}>WhatsApp</label>
            <input id={`${id}-wa`} name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" class={field} value="+54 9 " data-phone aria-describedby={`${id}-contact-hint`} />
            <p class="mt-1 text-small text-ink-muted">Con código de área, sin 0 ni 15.</p>
          </div>
          <div>
            <label class={labelCls} for={`${id}-email`}>Email</label>
            <input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="160" class={field} aria-describedby={`${id}-contact-hint`} />
          </div>
        </div>
      </fieldset>

      <label class="flex items-start gap-2 text-small">
        <input type="checkbox" name="consentimiento" value="si" required class="mt-1 accent-river" />
        <span>Acepto la <a href="/privacidad" target="_blank">Política de Privacidad</a> y que me contacten sobre mi consulta.</span>
      </label>

      {SITE.turnstileSiteKey && !SITE.preview && (
        <div data-turnstile-slot data-sitekey={SITE.turnstileSiteKey}></div>
      )}
      <input type="hidden" name="turnstile_state" value="none" />

      <input type="hidden" name="utm_source" />
      <input type="hidden" name="utm_medium" />
      <input type="hidden" name="utm_campaign" />
      <input type="hidden" name="utm_term" />
      <input type="hidden" name="utm_content" />
      <input type="hidden" name="gclid" />
      <input type="hidden" name="landing_page" />
      <input type="hidden" name="page" />
      <input type="hidden" name="pv" />

      <button type="submit" class="btn-primary w-full sm:w-auto" data-submit>Enviar consulta</button>

      <div role="alert" aria-live="assertive" class="hidden rounded-sm border border-signal bg-paper p-4 text-ink" data-error></div>
      <template data-fallback>
        No se pudo enviar. Tus datos siguen en el formulario. Probá de nuevo en un minuto, o escribime{fallbackWa ? <> por <a href={fallbackWa} data-wa="form-error" target="_blank" rel="noopener">WhatsApp</a> o</> : ''} a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </template>
    </form>
  </div>
</section>


<script>
  import { contactCheck, leadScore, thankYouPath } from '../lib/lead.js';
  import { sendFunnel, pageloadId } from '../lib/funnel-client.js';

  const track = (n: string, p: Record<string, unknown> = {}) => (window as any).ddTrack?.(n, p);
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Attribution: URL first, then first-touch values kept by Tracking.astro.
  const attribution = () => {
    let attr: Record<string, string> = {};
    try { attr = JSON.parse(localStorage.getItem('dd_attr') || '{}'); } catch {}
    const q = new URLSearchParams(location.search);
    const get = (k: string) => q.get(k) || attr[k] || '';
    return { get, landing: attr.landing_page || location.pathname };
  };

  document.querySelectorAll<HTMLFormElement>('form[data-quote-form]').forEach((form) => {
    const errorBox = form.querySelector<HTMLDivElement>('[data-error]')!;
    const fallback = form.querySelector<HTMLTemplateElement>('template[data-fallback]')!;
    const rubroSel = form.querySelector<HTMLSelectElement>('[data-rubro-select]')!;
    const specs = form.querySelector<HTMLTextAreaElement>('[data-specs]')!;
    const contactBox = form.querySelector<HTMLFieldSetElement>('[data-contact]')!;
    const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;
    const preview = !!form.dataset.preview;

    // ---- Cookieless funnel counters (one random id per page load; nothing stored in the browser) ----
    el('pv')!.value = pageloadId();
    const funnel = sendFunnel;

    // ---- Turnstile: loaded and rendered only after the first field interaction (form_start), managed mode,
    // invisible unless Cloudflare needs a challenge. Errors are silent and never block submit: the server
    // accepts the lead and flags it turnstile_unverified.
    const tsSlot = form.querySelector<HTMLDivElement>('[data-turnstile-slot]');
    const tsState = el('turnstile_state')!;
    const setTs = (state: 'pending' | 'ok' | 'error' | 'timeout') => { tsState.value = state; };
    const tsFail = (reason: 'widget' | 'timeout') => {
      if (tsState.value === 'ok') return;
      setTs(reason === 'widget' ? 'error' : 'timeout');
      funnel('turnstile_fail', reason);
      if (tsSlot) tsSlot.hidden = true; // never show a captcha error to the visitor
    };
    let tsRequested = false;
    const startTurnstile = () => {
      if (!tsSlot || tsRequested) return;
      tsRequested = true;
      setTs('pending');
      const render = () => {
        try {
          (window as any).turnstile.render(tsSlot, {
            sitekey: tsSlot.dataset.sitekey,
            appearance: 'interaction-only',
            language: 'es',
            theme: 'light',
            callback: () => { setTs('ok'); tsSlot.hidden = false; },
            'error-callback': () => { tsFail('widget'); return true; }, // true = handled, Turnstile shows nothing
            'timeout-callback': () => tsFail('timeout'),
            'expired-callback': () => { try { (window as any).turnstile.reset(tsSlot); } catch {} },
          });
        } catch { tsFail('widget'); }
      };
      if ((window as any).turnstile?.render) return render();
      (window as any).ddTurnstileReady = render;
      const sc = document.createElement('script');
      sc.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=ddTurnstileReady';
      sc.async = true;
      sc.onerror = () => tsFail('widget');
      document.head.appendChild(sc);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { funnel('form_view'); io.disconnect(); }
      }, { threshold: 0.25 });
      io.observe(form);
    }

    // Pre-fill rubro from ?rubro= (explicit links only; sector pages preselect it server-side).
    const qp = new URLSearchParams(location.search).get('rubro');
    if (qp && [...rubroSel.options].some((o) => o.value === qp)) rubroSel.value = qp;
    const syncPlaceholder = () => {
      const ph = rubroSel.selectedOptions[0]?.dataset.placeholder;
      if (ph) specs.placeholder = ph;
    };
    syncPlaceholder();
    rubroSel.addEventListener('change', syncPlaceholder);

    let started = false;
    form.addEventListener('focusin', (e) => {
      if (started || !(e.target as HTMLElement).matches('input:not([type=hidden]),select,textarea')) return;
      started = true;
      funnel('form_start');
      startTurnstile();
      track('form_start', { rubro: rubroSel.value || 'none' });
    });

    const errorTarget = (input: HTMLElement) =>
      input === contactBox ? contactBox : (input as HTMLInputElement).type === 'checkbox' ? input.closest('label')! : input;
    const setError = (input: HTMLElement | null, msg: string | null, key?: string) => {
      if (!input) return;
      const name = key || (input as HTMLInputElement).name;
      const errId = `${form.id || 'f'}-${name}-err`;
      form.querySelector(`#${CSS.escape(errId)}`)?.remove();
      if (msg) {
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-errormessage', errId);
        const p = document.createElement('p');
        p.id = errId;
        p.className = 'mt-1 text-small text-signal';
        p.textContent = msg;
        errorTarget(input).insertAdjacentElement('afterend', p);
      } else {
        input.removeAttribute('aria-invalid');
        input.removeAttribute('aria-errormessage');
      }
    };

    const fieldValidators: Record<string, (i: HTMLInputElement) => string | null> = {
      rubro: (i) => (i.value ? null : 'Elegí un rubro.'),
      valor_pedido: (i) => (i.value ? null : 'Elegí un rango; "No sé todavía" también sirve.'),
      producto: (i) => (i.value.trim().length >= 10 ? null : 'Contame un poco más: producto y cantidad.'),
      nombre: (i) => (i.value.trim().length >= 2 ? null : 'Completá tu nombre.'),
      consentimiento: (i) => (i.checked ? null : 'Necesito tu consentimiento para responderte.'),
    };
    const MSG = {
      whatsapp: 'Revisá el número: +54 9, código de área y número. O dejalo vacío y usá el email.',
      email: 'Revisá el email, o dejalo vacío y usá WhatsApp.',
      contact: 'Dejanos tu WhatsApp o tu email para poder responderte.',
    };
    const checkContact = () => {
      const c = contactCheck({ whatsapp: el('whatsapp')!.value, email: el('email')!.value });
      setError(el('whatsapp'), c.errors.whatsapp ? MSG.whatsapp : null);
      setError(el('email'), c.errors.email ? MSG.email : null);
      setError(contactBox, c.errors.contact ? MSG.contact : null, 'contact');
      return c;
    };

    // Returns the first failing field name, or null when the form is valid.
    const validate = (): string | null => {
      let first: string | null = null;
      let firstEl: HTMLElement | null = null;
      for (const name of ['rubro', 'valor_pedido', 'producto', 'nombre']) {
        const input = el(name)!;
        const msg = fieldValidators[name](input);
        setError(input, msg);
        if (msg && !first) { first = name; firstEl = input; }
      }
      const c = checkContact();
      const contactFail = c.errors.whatsapp ? 'whatsapp' : c.errors.email ? 'email' : c.errors.contact ? 'contact' : null;
      if (contactFail && !first) { first = contactFail; firstEl = contactFail === 'contact' ? el('whatsapp') : el(contactFail); }
      const consent = el('consentimiento')!;
      const cmsg = fieldValidators.consentimiento(consent);
      setError(consent, cmsg);
      if (cmsg && !first) { first = 'consentimiento'; firstEl = consent; }
      firstEl?.focus();
      return first;
    };

    // Clear errors as soon as they're fixed: while typing, not on blur, so the layout never shifts under a click.
    const recheck = (e: Event) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'whatsapp' || t.name === 'email') {
        if (form.querySelector('[data-contact] [aria-invalid], [data-contact][aria-invalid]')) checkContact();
      } else if (t.name in fieldValidators && t.getAttribute('aria-invalid') && !fieldValidators[t.name](t)) setError(t, null);
    };
    form.addEventListener('input', recheck);
    form.addEventListener('change', recheck);

    // Give a pending Turnstile check up to 8 s if the visitor submits very fast; never wait after an error.
    const waitForTurnstile = async () => {
      if (!tsSlot) return true;
      startTurnstile();
      for (let i = 0; i < 16; i++) {
        if (tsState.value === 'ok' || el('cf-turnstile-response')?.value) { setTs('ok'); return true; }
        if (tsState.value === 'error' || tsState.value === 'timeout') return true; // already counted
        await sleep(500);
      }
      return false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      funnel('submit_pressed');
      errorBox.classList.add('hidden');
      const blocked = validate();
      if (blocked) { funnel('submit_blocked', blocked); return; }
      if ((el('empresa_web')?.value ?? '') !== '') return; // bot

      const { get, landing } = attribution();
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'].forEach((k) => { el(k)!.value = get(k); });
      el('landing_page')!.value = landing;
      el('page')!.value = location.pathname;
      const valor = el('valor_pedido')!.value;
      const score = leadScore({ orderValue: valor });
      const c = contactCheck({ whatsapp: el('whatsapp')!.value, email: el('email')!.value });

      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      submit.disabled = true;
      submit.textContent = 'Enviando…';
      if (!preview && !(await waitForTurnstile())) tsFail('timeout');
      const data = new FormData(form);
      data.delete('empresa_web');
      data.set('whatsapp', c.whatsapp);
      data.set('email', c.email);

      try {
        if (preview) {
          console.info('[quote-form] preview build, not sent:', Object.fromEntries(data));
        } else {
          const res = await fetch(form.dataset.endpoint!, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) {
            (window as any).turnstile?.reset?.();
            throw new Error(`HTTP ${res.status}`);
          }
        }
      } catch (err) {
        console.error(err);
        errorBox.replaceChildren(fallback.content.cloneNode(true));
        errorBox.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = 'Enviar consulta';
        return;
      }

      track('generate_lead', { rubro: el('rubro')?.value, valor, lead_score: score });
      if (score === 'A') track('qualified_lead', { rubro: el('rubro')?.value });
      try {
        sessionStorage.setItem('dd_lead', JSON.stringify({
          nombre: (el('nombre')!.value || '').trim().split(/\s+/)[0],
          producto: (el('producto')!.value || '').trim().split('\n')[0].slice(0, 80),
        }));
      } catch {}
      const dest = thankYouPath(valor);
      setTimeout(() => location.assign(preview ? dest.slice(1) + '.html' : dest), 300);
    });
  });
</script>
