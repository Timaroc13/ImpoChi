---
// Two-step RFQ form (brief §10.5). Posts multipart/form-data to PUBLIC_FORM_ENDPOINT (n8n webhook etc.).
import { RUBROS } from '../data/verticals';
import { ORDER_VALUES, TIMELINES } from '../lib/lead.js';
import { SITE, hasWhatsApp } from '../config';
import { waLink } from '../lib/lead.js';

interface Props { rubro?: string; heading?: string; id?: string }
const { rubro = '', heading = 'Pedí tu cotización', id = 'cotizar' } = Astro.props;

const PROVINCIAS = [
  'Ciudad Autónoma de Buenos Aires', 'Buenos Aires', 'Catamarca', 'Chaco', 'Chubut', 'Córdoba', 'Corrientes', 'Entre Ríos',
  'Formosa', 'Jujuy', 'La Pampa', 'La Rioja', 'Mendoza', 'Misiones', 'Neuquén', 'Río Negro', 'Salta', 'San Juan',
  'San Luis', 'Santa Cruz', 'Santa Fe', 'Santiago del Estero', 'Tierra del Fuego', 'Tucumán',
];
const EXPERIENCE = [
  { value: 'nunca', label: 'Nunca' },
  { value: 'plataforma', label: 'Sí, por Alibaba u otra plataforma' },
  { value: 'agente', label: 'Sí, con un agente' },
  { value: 'viaje', label: 'Sí, viajé a fábricas' },
];
const CARGOS = ['Dueño/a o socio/a', 'Compras', 'Comercio exterior', 'Otro'];
const fallbackWa = hasWhatsApp ? waLink(SITE.whatsapp, 'Hola Octa, intenté mandar el formulario y no funcionó. Te cuento mi pedido: ') : '';
const field = 'mt-2 block w-full rounded-sm border border-line bg-paper-raised px-4 py-3 text-body text-ink placeholder:text-ink-muted/80 aria-[invalid=true]:border-signal';
const labelCls = 'block font-semibold';
const req = '<span class="text-ink-muted font-normal"> (obligatorio)</span>';
---
<section id={id} class="section scroll-mt-4" aria-labelledby={`${id}-title`}>
  <div class="wrap max-w-[760px]">
    <h2 id={`${id}-title`} class="text-h1-m md:text-h1">{heading}</h2>
    {SITE.preview && <p class="mt-4 rounded-sm bg-river-soft p-4 text-small text-ink">Vista previa: este formulario no envía datos. Al terminar te lleva a la página de confirmación.</p>}
    <p class="mt-2 text-ink-muted">Dos pasos, unos 5 minutos. Te respondo en 24 h hábiles, hora de Buenos Aires.</p>

    <form
      class="card mt-6 md:p-10"
      data-quote-form
      data-endpoint={SITE.formEndpoint}
      data-preview={SITE.preview ? '1' : undefined}
      novalidate
      enctype="multipart/form-data"
    >
      <div class="mb-6">
        <div class="flex justify-between text-small text-ink-muted"><span data-step-label>Paso 1 de 2: tu pedido</span><span class="fig text-small" data-step-pct>50 %</span></div>
        <div class="mt-2 h-1 w-full bg-line" role="progressbar" aria-label="Progreso del formulario" aria-valuemin="0" aria-valuemax="2" aria-valuenow="1" data-progress>
          <div class="h-1 w-1/2 bg-river transition-[width]" data-progress-bar></div>
        </div>
      </div>

      <!-- honeypot -->
      <div class="hidden" aria-hidden="true"><label>No completar <input type="text" name="empresa_web" tabindex="-1" autocomplete="off" /></label></div>

      <fieldset data-step="1" class="space-y-6">
        <legend class="sr-only">Paso 1: tu pedido</legend>
        <div>
          <label class={labelCls} for={`${id}-rubro`}>Rubro<Fragment set:html={req} /></label>
          <select id={`${id}-rubro`} name="rubro" required class={field} data-rubro-select>
            <option value="" disabled selected={!rubro}>Elegí una opción</option>
            {RUBROS.map((r) => <option value={r.value} selected={r.value === rubro} data-placeholder={r.placeholder}>{r.label}</option>)}
          </select>
        </div>
        <div>
          <label class={labelCls} for={`${id}-producto`}>¿Qué necesitás comprar o fabricar?<Fragment set:html={req} /></label>
          <input id={`${id}-producto`} name="producto" type="text" required minlength="10" maxlength="200" class={field} placeholder="Ej.: llenadora de botellas de 1 litro" />
        </div>
        <div>
          <label class={labelCls} for={`${id}-specs`}>Especificaciones</label>
          <textarea id={`${id}-specs`} name="especificaciones" rows="4" maxlength="3000" class={field} data-specs placeholder={RUBROS.find((r) => r.value === rubro)?.placeholder ?? 'Medidas, materiales, capacidad, normas, lo que tengas.'}></textarea>
          <label class="mt-2 block text-small text-ink-muted" for={`${id}-files`}>Planos, fotos o fichas (PDF, JPG o PNG, hasta 10 MB en total)</label>
          <input id={`${id}-files`} name="archivos" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" class="mt-2 block w-full text-small file:mr-4 file:rounded-sm file:border file:border-line file:bg-paper file:px-4 file:py-2 file:text-ink" />
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label class={labelCls} for={`${id}-cantidad`}>Cantidad estimada<Fragment set:html={req} /></label>
            <input id={`${id}-cantidad`} name="cantidad" type="text" required maxlength="100" class={field} placeholder="Ej.: 2 máquinas, 5.000 cajas" />
          </div>
          <div>
            <label class={labelCls} for={`${id}-precio`}>Precio objetivo por unidad</label>
            <input id={`${id}-precio`} name="precio_objetivo" type="text" maxlength="100" class={field} placeholder="Ej.: USD 0,80" />
          </div>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label class={labelCls} for={`${id}-valor`}>Valor estimado del pedido<Fragment set:html={req} /></label>
            <select id={`${id}-valor`} name="valor_pedido" required class={field}>
              <option value="" disabled selected>Elegí una opción</option>
              {ORDER_VALUES.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
          <div>
            <label class={labelCls} for={`${id}-plazo`}>¿Para cuándo lo necesitás?<Fragment set:html={req} /></label>
            <select id={`${id}-plazo`} name="plazo" required class={field}>
              <option value="" disabled selected>Elegí una opción</option>
              {TIMELINES.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
        </div>
        <fieldset>
          <legend class={labelCls}>¿Ya compraste en China?</legend>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            {EXPERIENCE.map((o) => (
              <label class="flex items-center gap-2 rounded-sm border border-line bg-paper-raised px-4 py-3"><input type="radio" name="experiencia" value={o.value} class="accent-river" /> {o.label}</label>
            ))}
          </div>
        </fieldset>
        <div class="flex justify-end">
          <button type="button" class="btn-primary" data-next>Siguiente</button>
        </div>
      </fieldset>

      <fieldset data-step="2" class="space-y-6" hidden>
        <legend class="sr-only">Paso 2: tus datos</legend>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label class={labelCls} for={`${id}-nombre`}>Nombre y apellido<Fragment set:html={req} /></label>
            <input id={`${id}-nombre`} name="nombre" type="text" required autocomplete="name" maxlength="120" class={field} />
          </div>
          <div>
            <label class={labelCls} for={`${id}-empresa`}>Empresa<Fragment set:html={req} /></label>
            <input id={`${id}-empresa`} name="empresa" type="text" required autocomplete="organization" maxlength="120" class={field} />
          </div>
        </div>
        <fieldset>
          <legend class={labelCls}>¿Tu empresa es Responsable Inscripto o sociedad (SRL/SA)?<Fragment set:html={req} /></legend>
          <div class="mt-2 flex flex-wrap gap-2" data-radio-required="ri">
            {[['si', 'Sí'], ['no', 'No'], ['nose', 'No sé']].map(([v, l]) => (
              <label class="flex items-center gap-2 rounded-sm border border-line bg-paper-raised px-4 py-3"><input type="radio" name="ri" value={v} required class="accent-river" /> {l}</label>
            ))}
          </div>
        </fieldset>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label class={labelCls} for={`${id}-cuit`}>CUIT</label>
            <input id={`${id}-cuit`} name="cuit" type="text" inputmode="numeric" autocomplete="off" maxlength="13" class={field} placeholder="30-12345678-9" data-cuit />
          </div>
          <div>
            <label class={labelCls} for={`${id}-cargo`}>Cargo</label>
            <select id={`${id}-cargo`} name="cargo" class={field}>
              <option value="" selected>Elegí una opción</option>
              {CARGOS.map((c) => <option>{c}</option>)}
            </select>
          </div>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label class={labelCls} for={`${id}-wa`}>WhatsApp<Fragment set:html={req} /></label>
            <input id={`${id}-wa`} name="whatsapp" type="tel" required autocomplete="tel" inputmode="tel" maxlength="24" class={field} value="+54 9 " data-phone />
            <p class="mt-1 text-small text-ink-muted">Celular con código de área, sin 0 ni 15. Ej.: +54 9 11 2345 6789.</p>
          </div>
          <div>
            <label class={labelCls} for={`${id}-email`}>Email<Fragment set:html={req} /></label>
            <input id={`${id}-email`} name="email" type="email" required autocomplete="email" maxlength="160" class={field} />
          </div>
        </div>
        <div>
          <label class={labelCls} for={`${id}-prov`}>Provincia</label>
          <select id={`${id}-prov`} name="provincia" class={field}>
            <option value="" selected>Elegí una opción</option>
            {PROVINCIAS.map((p) => <option>{p}</option>)}
            <option>Fuera de Argentina</option>
          </select>
        </div>
        <label class="flex items-start gap-2">
          <input type="checkbox" name="consentimiento" value="si" required class="mt-1.5 accent-river" />
          <span>Acepto la <a href="/privacidad" target="_blank">Política de Privacidad</a> y que me contacten por WhatsApp y email sobre mi consulta.<Fragment set:html={req} /></span>
        </label>

        <input type="hidden" name="utm_source" />
        <input type="hidden" name="utm_medium" />
        <input type="hidden" name="utm_campaign" />
        <input type="hidden" name="utm_term" />
        <input type="hidden" name="utm_content" />
        <input type="hidden" name="gclid" />
        <input type="hidden" name="landing_page" />
        <input type="hidden" name="page" />
        <input type="hidden" name="lead_score" />
        <input type="hidden" name="enviado" />

        <div class="flex flex-col-reverse gap-4 sm:flex-row sm:justify-between">
          <button type="button" class="btn-secondary" data-back>Volver</button>
          <button type="submit" class="btn-primary" data-submit>Enviar consulta</button>
        </div>
      </fieldset>

      <div role="alert" aria-live="assertive" class="mt-6 hidden rounded-sm border border-signal bg-paper p-4 text-ink" data-error></div>
      <template data-fallback>
        No se pudo enviar. Tus datos siguen en el formulario. Probá de nuevo en un minuto, o escribime{fallbackWa ? <> por <a href={fallbackWa} data-wa="form-error" target="_blank" rel="noopener">WhatsApp</a> o</> : ''} a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </template>
    </form>
  </div>
</section>

<script>
  import { isValidCuit, normalizePhone, isValidEmail, leadScore, thankYouPath } from '../lib/lead.js';

  const MAX_BYTES = 10 * 1024 * 1024;
  const track = (n: string, p: Record<string, unknown> = {}) => (window as any).ddTrack?.(n, p);

  document.querySelectorAll<HTMLFormElement>('form[data-quote-form]').forEach((form) => {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-step]')];
    const errorBox = form.querySelector<HTMLDivElement>('[data-error]')!;
    const fallback = form.querySelector<HTMLTemplateElement>('template[data-fallback]')!;
    const bar = form.querySelector<HTMLDivElement>('[data-progress-bar]')!;
    const progress = form.querySelector<HTMLDivElement>('[data-progress]')!;
    const stepLabel = form.querySelector<HTMLSpanElement>('[data-step-label]')!;
    const stepPct = form.querySelector<HTMLSpanElement>('[data-step-pct]')!;
    const rubroSel = form.querySelector<HTMLSelectElement>('[data-rubro-select]')!;
    const specs = form.querySelector<HTMLTextAreaElement>('[data-specs]')!;
    const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;

    // Pre-fill rubro from ?rubro= (ads can point straight to /cotizacion?rubro=packaging)
    const qp = new URLSearchParams(location.search).get('rubro');
    if (qp && [...rubroSel.options].some((o) => o.value === qp)) rubroSel.value = qp;
    const syncPlaceholder = () => {
      const ph = rubroSel.selectedOptions[0]?.dataset.placeholder;
      if (ph) specs.placeholder = ph;
    };
    syncPlaceholder();
    rubroSel.addEventListener('change', syncPlaceholder);

    let started = false;
    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('form_start', { rubro: rubroSel.value || 'none' });
    });

    const setError = (input: Element | null, msg: string | null) => {
      if (!input) return;
      const holder = (input.closest('[data-radio-required]') ?? input) as HTMLElement;
      const errId = `${(input as HTMLInputElement).name}-err`;
      form.querySelector(`#${CSS.escape(errId)}`)?.remove();
      if (msg) {
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', errId);
        const p = document.createElement('p');
        p.id = errId;
        p.className = 'mt-1 text-small text-signal';
        p.textContent = msg;
        holder.insertAdjacentElement('afterend', p);
      } else {
        input.removeAttribute('aria-invalid');
        input.removeAttribute('aria-describedby');
      }
    };

    const validators: Record<string, (v: string, i: HTMLInputElement) => string | null> = {
      rubro: (v) => (v ? null : 'Elegí un rubro.'),
      producto: (v) => (v.trim().length >= 10 ? null : 'Contame un poco más (al menos 10 caracteres).'),
      cantidad: (v) => (v.trim() ? null : 'Indicá una cantidad aproximada.'),
      valor_pedido: (v) => (v ? null : 'Elegí un rango; "No sé todavía" también sirve.'),
      plazo: (v) => (v ? null : 'Elegí una opción.'),
      archivos: (_v, i) => {
        const total = [...(i.files ?? [])].reduce((s, f) => s + f.size, 0);
        return total > MAX_BYTES ? 'Los archivos superan 10 MB en total. Mandá los más importantes y el resto por WhatsApp o email.' : null;
      },
      nombre: (v) => (v.trim().length >= 3 ? null : 'Completá tu nombre y apellido.'),
      empresa: (v) => (v.trim().length >= 2 ? null : 'Completá el nombre de tu empresa.'),
      ri: () => (form.querySelector('input[name="ri"]:checked') ? null : 'Elegí una opción.'),
      cuit: (v) => (!v.trim() || isValidCuit(v) ? null : 'El CUIT no es válido. Revisalo o dejalo vacío.'),
      whatsapp: (v) => (normalizePhone(v).ok ? null : 'Revisá el número: +54 9, código de área y número, sin 0 ni 15.'),
      email: (v) => (isValidEmail(v) ? null : 'Revisá el email.'),
      consentimiento: (_v, i) => (i.checked ? null : 'Necesito tu consentimiento para responderte.'),
    };

    const validateStep = (idx: number) => {
      let firstBad: HTMLElement | null = null;
      const names = new Set(
        [...steps[idx].querySelectorAll<HTMLInputElement>('[name]')].map((i) => i.name).filter((n) => n in validators),
      );
      names.forEach((name) => {
        const input = steps[idx].querySelector<HTMLInputElement>(`[name="${name}"]`)!;
        const msg = validators[name](input.value ?? '', input);
        setError(input, msg);
        if (msg && !firstBad) firstBad = input;
      });
      if (firstBad) (firstBad as HTMLElement).focus();
      return !firstBad;
    };

    const show = (idx: number) => {
      steps.forEach((s, i) => (s.hidden = i !== idx));
      bar.style.width = idx === 0 ? '50%' : '100%';
      progress.setAttribute('aria-valuenow', String(idx + 1));
      stepLabel.textContent = idx === 0 ? 'Paso 1 de 2: tu pedido' : 'Paso 2 de 2: tus datos';
      stepPct.textContent = idx === 0 ? '50 %' : '100 %';
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      steps[idx].querySelector<HTMLElement>('input,select,textarea')?.focus({ preventScroll: true });
    };

    form.querySelector('[data-next]')!.addEventListener('click', () => {
      if (!validateStep(0)) return;
      track('form_step1_complete', { rubro: rubroSel.value, valor: el('valor_pedido')!.value });
      show(1);
    });
    form.querySelector('[data-back]')!.addEventListener('click', () => show(0));

    // Clear an error as soon as the field is fixed
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name in validators && t.getAttribute('aria-invalid')) setError(t, validators[t.name](t.value, t));
      if (t.name === 'ri') setError(form.querySelector('input[name="ri"]'), null);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      if (!validateStep(1)) return;
      if ((el('empresa_web')?.value ?? '') !== '') return; // bot

      // Attribution + derived fields
      let attr: Record<string, string> = {};
      try { attr = JSON.parse(localStorage.getItem('dd_attr') || '{}'); } catch {}
      const q = new URLSearchParams(location.search);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'].forEach((k) => {
        el(k)!.value = q.get(k) || attr[k] || '';
      });
      el('landing_page')!.value = attr.landing_page || location.pathname;
      el('page')!.value = location.pathname;
      const ri = (form.querySelector('input[name="ri"]:checked') as HTMLInputElement).value;
      const valor = el('valor_pedido')!.value;
      const plazo = el('plazo')!.value;
      const score = leadScore({ ri, orderValue: valor, timeline: plazo });
      el('lead_score')!.value = score;
      el('enviado')!.value = new Date().toISOString();
      const phone = el('whatsapp')!;
      phone.value = normalizePhone(phone.value).e164;
      const cuit = el('cuit')!;
      cuit.value = cuit.value.replace(/\D/g, '');

      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      submit.disabled = true;
      submit.textContent = 'Enviando…';

      const endpoint = form.dataset.endpoint;
      const data = new FormData(form);
      data.delete('empresa_web');
      const fileInput = el('archivos');
      if (fileInput && !fileInput.files?.length) data.delete('archivos');

      try {
        if (form.dataset.preview) {
          console.info('[quote-form] preview build, not sent:', Object.fromEntries(data));
        } else if (!endpoint) {
          if (import.meta.env.DEV) console.warn('[quote-form] PUBLIC_FORM_ENDPOINT is not set; payload:', Object.fromEntries(data));
          else throw new Error('no endpoint');
        } else {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
        }
      } catch (err) {
        console.error(err);
        errorBox.replaceChildren(fallback.content.cloneNode(true));
        errorBox.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = 'Enviar consulta';
        return;
      }

      track('generate_lead', { rubro: el('rubro')?.value, valor: valor, lead_score: score });
      if (score === 'A') track('qualified_lead', { rubro: el('rubro')?.value });
      try {
        sessionStorage.setItem('dd_lead', JSON.stringify({
          nombre: (el('nombre')!.value || '').trim().split(/\s+/)[0],
          producto: (el('producto')!.value || '').trim().slice(0, 80),
        }));
      } catch {}
      // let analytics beacons flush
      // Preview builds are hosted as plain .html files, so link to the file.
      const dest = thankYouPath(valor);
      setTimeout(() => location.assign(form.dataset.preview ? dest.slice(1) + '.html' : dest), 300);
    });
  });
</script>
