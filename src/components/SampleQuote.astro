---
// Anonymised sample quote comparison. Illustrative numbers, labelled as such.
import { fmtUSD, fmtNum } from '../lib/format.js';
const rows = [
  { f: 'Fábrica A', place: 'Dongguan', fob: 18400, landed: 24840, lead: 35, moq: '1 equipo', inspect: 'Aprobado', rec: false },
  { f: 'Fábrica B', place: 'Foshan', fob: 16900, landed: 22980, lead: 45, moq: '1 equipo', inspect: 'Aprobado', rec: true },
  { f: 'Fábrica C', place: 'Guangzhou', fob: 15200, landed: 20670, lead: 50, moq: '2 equipos', inspect: 'Observado', rec: false },
];
---
<figure class="overflow-x-auto">
  <table class="w-full min-w-[640px] border-collapse bg-paper-raised text-left">
    <caption class="caption-bottom pt-4 text-left text-small text-ink-muted">Ejemplo ilustrativo: llenadora de 6 picos, 380 V, 50 Hz. Costo puesto en Argentina estimado a 1,35 × FOB, después de recuperar créditos fiscales.</caption>
    <thead>
      <tr class="border-b border-ink">
        <th scope="col" class="eyebrow px-4 py-2">Fábrica</th>
        <th scope="col" class="eyebrow px-4 py-2 text-right">FOB Shenzhen</th>
        <th scope="col" class="eyebrow px-4 py-2 text-right">Puesto en AR (est.)</th>
        <th scope="col" class="eyebrow px-4 py-2 text-right">Plazo</th>
        <th scope="col" class="eyebrow px-4 py-2">Mínimo</th>
        <th scope="col" class="eyebrow px-4 py-2">Auditoría de fábrica</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class:list={['border-b border-line', r.rec && 'bg-river-soft']}>
          <th scope="row" class="px-4 py-4 font-semibold">{r.f}<br /><span class="text-small font-normal text-ink-muted">{r.place}{r.rec && ' · recomendada'}</span></th>
          <td class="fig px-4 py-4 text-right">{fmtUSD(r.fob)}</td>
          <td class="fig px-4 py-4 text-right">{fmtUSD(r.landed)}</td>
          <td class="fig px-4 py-4 text-right">{fmtNum(r.lead)} días</td>
          <td class="px-4 py-4 text-small">{r.moq}</td>
          <td class="px-4 py-4"><span class:list={['chip font-semibold', r.inspect === 'Aprobado' ? 'border-river text-river' : 'border-signal text-signal']}>{r.inspect}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</figure>
