---
import type { QA } from '../data/faq';
interface Props { items: QA[]; title?: string; id?: string }
const { items, title = 'Preguntas frecuentes', id = 'faq' } = Astro.props;
---
<section class="section" aria-labelledby={`${id}-title`}>
  <div class="wrap max-w-[860px]">
    <h2 id={`${id}-title`} class="text-h1-m md:text-h1">{title}</h2>
    <div class="mt-6 border-b border-line">
      {items.map((it) => (
        <details class="group border-t border-line" data-faq={it.q}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 font-semibold">
            <span>{it.q}</span>
            <span class="fig text-river group-open:hidden" aria-hidden="true">+</span>
            <span class="fig hidden text-river group-open:inline" aria-hidden="true">−</span>
          </summary>
          <p class="max-w-[68ch] pb-6 text-ink">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
